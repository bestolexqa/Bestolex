    {
      "id": "heap",
      "label": {
        "en": "Gold heap-leaching process (turnkey)",
        "ar": "الإذابة الكومية للذهب (تسليم مفتاح)"
      },
      "models": [
        {
          "code": "BX-0028-01-047",
          "name": {
            "en": "Heap-leaching circuit",
            "ar": "دائرة الإذابة الكومية"
          },
          "specs": {
            "steps": {
              "en": "Crushing (or agglomeration) of low-grade ore; stacking on an impermeable asphalt or plastic pad; dilute leaching solution sprayed over the heap; the gold-bearing solution pumped to carbon adsorption, then elution and electrowinning",
              "ar": "تكسير الخام منخفض الرتبة (أو تكتيله)؛ ثم تكديسه على أرضية عازلة من الأسفلت أو البلاستيك؛ ثم رش محلول الإذابة المخفف فوق الكومة؛ ثم ضخ المحلول الحامل للذهب إلى أحواض الامتزاز على الكربون، ثم الاستخلاص والتحليل الكهربائي"
            },
            "equipment": {
              "en": "Vibrating feeder, jaw and cone crushers, circular vibrating screen, belt conveyors, pregnant-solution pump, adsorption tanks with air lifters, carbon sieves and fine-carbon safety screen, spray pump",
              "ar": "مغذٍّ اهتزازي، وكسارتان فكية ومخروطية، وغربال اهتزازي دائري، وسيور ناقلة، ومضخة المحلول الحامل، وأحواض امتزاز برافعات هوائية، ومناخل الكربون وغربال أمان للكربون الناعم، ومضخة رش"
            }
          }
        }
      ],
